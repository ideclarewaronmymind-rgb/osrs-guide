<!-- QUEST HUB -->
<section id="questhub">
  <h2>Quest Hub</h2>

  <div class="tab-container">
    <div class="tabs">
      <button class="tab-button active" data-tab="quests1">Early Game</button>
      <button class="tab-button" data-tab="quests2">Mid Game</button>
      <button class="tab-button" data-tab="quests3">Late Game</button>
    </div>

    <div id="quests1" class="tab-content active">
      <label><input type="checkbox"> Cook's Assistant</label><br>
      <label><input type="checkbox"> Sheep Shearer</label><br>
      <label><input type="checkbox"> Witch’s Potion</label>
    </div>

    <div id="quests2" class="tab-content">
      <label><input type="checkbox"> Dragon Slayer</label><br>
      <label><input type="checkbox"> Hero’s Quest</label>
    </div>

    <div id="quests3" class="tab-content">
      <label><input type="checkbox"> Monkey Madness II</label><br>
      <label><input type="checkbox"> Theatre of Blood</label>
    </div>
  </div>
</section>


<!-- SKILL TRACKER -->
<section id="skills">
  <h2>Skill Tracker</h2>

  <div class="tab-container">

    <!-- Skill -->
    <div style="margin-bottom:15px;">
      <label>Attack: <span id="attackLevel">1</span></label>
      <input type="range" min="1" max="99" value="1" oninput="updateSkill('attack', this.value)">
    </div>

    <div style="margin-bottom:15px;">
      <label>Strength: <span id="strengthLevel">1</span></label>
      <input type="range" min="1" max="99" value="1" oninput="updateSkill('strength', this.value)">
    </div>

    <div style="margin-bottom:15px;">
      <label>Defense: <span id="defenseLevel">1</span></label>
      <input type="range" min="1" max="99" value="1" oninput="updateSkill('defense', this.value)">
    </div>

    <div style="margin-bottom:15px;">
      <label>Magic: <span id="magicLevel">1</span></label>
      <input type="range" min="1" max="99" value="1" oninput="updateSkill('magic', this.value)">
    </div>

    <!-- Overall tracker -->
    <h3>Total Progress</h3>
    <div style="background:#333; border-radius:5px;">
      <div id="progressBar" style="height:20px; width:1%; background:#c3a45e;"></div>
    </div>
  </div>
</section>


<script>
/* TAB SYSTEM */
const buttons = document.querySelectorAll(".tab-button");
const contents = document.querySelectorAll(".tab-content");

buttons.forEach(button => {
  button.addEventListener("click", () => {
    buttons.forEach(btn => btn.classList.remove("active"));
    contents.forEach(c => c.classList.remove("active"));

    button.classList.add("active");
    document.getElementById(button.dataset.tab).classList.add("active");
  });
});

/* SKILL TRACKER */
const skills = {
  attack: 1,
  strength: 1,
  defense: 1,
  magic: 1
};

function updateSkill(skill, value) {
  skills[skill] = parseInt(value);
  document.getElementById(skill + "Level").innerText = value;

  updateProgress();
}

function updateProgress() {
  const total = Object.values(skills).reduce((a, b) => a + b, 0);
  const max = 99 * Object.keys(skills).length;

  const percent = (total / max) * 100;
  document.getElementById("progressBar").style.width = percent + "%";
}

/* INIT */
updateProgress();
</script>
